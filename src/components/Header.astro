---
import { translations } from "../i18n/translations";
import Dock from "@astroanimate/core/Dock";
import DockItem from "@astroanimate/core/DockItem";

interface Props {
  lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const t = translations[lang];
---

<!-- Barra estática superior: NIGELL JAMA permanece en el inicio y no acompaña el scroll -->
<div class="static-brand-header">
  <div class="container static-brand-container">
    <a href={lang === "es" ? "/es" : "/"} class="logo-group">
      <span class="logo-text">Nigell Jama</span>
    </a>
  </div>
</div>

<header class="sticky-header">
  <div class="container header-container">
    <div class="logo-spacer" aria-hidden="true"></div>

    <!-- Columna 2: OPCIONES NAV CON EFECTO DOCK (TEXTO SOLO EN PANTALLAS GRANDES) -->
    <div class="nav-links">
      <Dock
        enhance={true}
        position="top"
        size="sm"
        magnification={1.25}
        distance={100}
        color="var(--glass-bg)"
        blur="var(--glass-blur, 16px)"
        class="header-dock"
      >
        <DockItem>
          <a href={lang === "es" ? "/es" : "/"} class="dock-nav-link">
            <span class="dock-nav-text">{t.nav_home}</span>
          </a>
        </DockItem>
        <DockItem>
          <a
            href={lang === "es" ? "/es#skills" : "/#skills"}
            class="dock-nav-link"
          >
            <span class="dock-nav-text">{t.nav_skills}</span>
          </a>
        </DockItem>
        <DockItem>
          <a
            href={lang === "es" ? "/es#projects" : "/#projects"}
            class="dock-nav-link"
          >
            <span class="dock-nav-text">{t.nav_projects}</span>
          </a>
        </DockItem>
        <DockItem>
          <a
            href={lang === "es" ? "/es#contact" : "/#contact"}
            class="dock-nav-link"
          >
            <span class="dock-nav-text">{t.nav_contact}</span>
          </a>
        </DockItem>
      </Dock>
    </div>

    <!-- Columna 3: CAMBIO DE IDIOMA Y ESTILO CLARO U OSCURO -->
    <div class="actions">
      <div class="lang-selector-container">
        <button
          class="lang-selector-btn"
          id="lang-selector-btn"
          aria-label="Select Language"
        >
          <span class="lang-current">{lang === "es" ? "ES" : "EN"}</span>
        </button>
        <div class="lang-dropdown" id="lang-dropdown">
          <a href="/" class={`lang-option ${lang === "en" ? "active" : ""}`}>
            EN
          </a>
          <a href="/es" class={`lang-option ${lang === "es" ? "active" : ""}`}>
            ES
          </a>
        </div>
      </div>

      <button
        id="theme-toggle"
        class="theme-toggle-btn"
        aria-label="Toggle theme"
      >
        <span class="material-symbols-outlined theme-icon-dark">dark_mode</span>
        <span class="material-symbols-outlined theme-icon-light"
          >light_mode</span
        >
      </button>

      <!-- <a
        href={lang === "es"
          ? "/docs/CV-Jama_Nigell_ES.pdf"
          : "/docs/CV-Jama_Nigell.pdf"}
        download
        class="resume-btn">{t.resume}</a
      > -->
    </div>
  </div>
</header>

<nav class="bottom-nav" aria-label="Navegación móvil">
  <a
    href={lang === "es" ? "/es" : "/"}
    class="bottom-nav-item"
    aria-label={t.nav_home}
    title={t.nav_home}
  >
    <span class="material-symbols-outlined">home</span>
    <span class="bottom-nav-label">{t.nav_home}</span>
  </a>
  <a
    href={lang === "es" ? "/es#skills" : "/#skills"}
    class="bottom-nav-item"
    aria-label={t.nav_skills}
    title={t.nav_skills}
  >
    <span class="material-symbols-outlined">data_object</span>
    <span class="bottom-nav-label">{t.nav_skills}</span>
  </a>
  <a
    href={lang === "es" ? "/es#projects" : "/#projects"}
    class="bottom-nav-item"
    aria-label={t.nav_projects}
    title={t.nav_projects}
  >
    <span class="material-symbols-outlined">code</span>
    <span class="bottom-nav-label">{t.nav_projects}</span>
  </a>
  <a
    href={lang === "es" ? "/es#contact" : "/#contact"}
    class="bottom-nav-item"
    aria-label={t.nav_contact}
    title={t.nav_contact}
  >
    <span class="material-symbols-outlined">alternate_email</span>
    <span class="bottom-nav-label">{t.nav_contact}</span>
  </a>
</nav>

<style>
  /* Barra superior estática: el Logo se mantiene en la cabecera original y no acompaña el scroll */
  .static-brand-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 40;
    padding: 1rem 0 0.5rem 0;
    pointer-events: none;
  }

  .static-brand-container {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    min-height: 2.75rem;
  }

  .sticky-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: transparent !important;
    background-color: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 1rem 0 0.5rem 0;
    pointer-events: none;
    transition: all var(--transition-fast);
  }

  .sticky-header.scrolled {
    background: transparent !important;
    background-color: transparent !important;
    box-shadow: none !important;
  }

  .header-container {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    min-height: 2.75rem;
  }

  .logo-spacer {
    display: none;
  }

  /* Columna 1: Logo */
  .logo-group {
    display: inline-flex;
    align-items: center;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
    pointer-events: auto;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .logo-group:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .logo-text {
    font-family: var(--font-script, "Kaushan Script", cursive);
    font-size: 1.85rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: var(--primary);
    line-height: 1;
    transition: all var(--transition-fast);
  }

  /* Columna 2: Isla Opciones Nav (Dock) */
  .nav-links {
    display: none;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
  }

  :global(.header-dock.astro-dock-container) {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    width: auto !important;
  }

  :global(.header-dock .astro-dock) {
    height: 2.85rem !important;
    --dock-padding: 0.35rem !important;
    border-radius: var(--radius-full) !important;
    border: 1px solid var(--glass-border) !important;
    box-shadow: var(--glass-shadow) !important;
    background: var(--glass-bg) !important;
    backdrop-filter: blur(var(--glass-blur, 16px)) !important;
    -webkit-backdrop-filter: blur(var(--glass-blur, 16px)) !important;
    padding: 0 0.5rem !important;
    gap: 0.25rem !important;
    transition: all var(--transition-fast);
    transform-origin: center center !important;
  }

  :global(.header-dock .astro-dock:hover) {
    background: var(--glass-bg-hover) !important;
  }

  :global(.header-dock .dock-item) {
    width: auto !important;
    height: 2.15rem !important;
    padding: 0 0.85rem !important;
    border-radius: var(--radius-full) !important;
    margin: 0 2px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    white-space: nowrap !important;
  }

  :global(.header-dock .dock-nav-link) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    transition: color var(--transition-fast);
    white-space: nowrap;
  }

  :global(.header-dock .dock-nav-text) {
    display: inline-block;
    white-space: nowrap;
    line-height: 1;
    pointer-events: none;
    font-size: 0.875rem;
  }

  :global(.header-dock .dock-nav-link:hover),
  :global(.header-dock .dock-item.is-active .dock-nav-link) {
    color: var(--primary);
  }

  /* Columna 3: Isla Idioma, Tema y CV */
  .actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.6rem;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur, 16px));
    -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    border-radius: var(--radius-full);
    pointer-events: auto;
    transition: all var(--transition-fast);
  }

  .actions:hover {
    background: var(--glass-bg-hover);
  }

  .theme-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    background: transparent;
    border: none;
    border-radius: var(--radius-full);
    color: var(--text-primary);
    cursor: pointer;
    transition: all var(--transition-fast);
    padding: 0;
  }

  .theme-toggle-btn:hover {
    color: var(--primary);
    background-color: var(--glass-bg-hover);
  }

  .theme-toggle-btn span {
    font-size: 1.25rem;
    transition: transform var(--transition-normal);
  }

  .theme-toggle-btn:hover span {
    transform: rotate(15deg);
  }

  .theme-icon-light {
    display: none;
  }

  .theme-icon-dark {
    display: block;
  }

  :global(html.dark) .theme-icon-light {
    display: block;
  }

  :global(html.dark) .theme-icon-dark {
    display: none;
  }

  .lang-selector-container {
    position: relative;
  }

  .lang-selector-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: var(--radius-full);
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .lang-selector-btn:hover {
    color: var(--primary);
    background-color: var(--glass-bg-hover);
  }

  .lang-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    min-width: 3.5rem;
    width: max-content;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur, 16px));
    -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    box-shadow: var(--glass-shadow);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: all var(--transition-fast);
    z-index: 100;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .lang-selector-container.open .lang-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .lang-option {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.75rem;
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.05em;
    transition: all var(--transition-fast);
  }

  .lang-option:hover {
    background-color: var(--glass-bg-hover);
    color: var(--primary);
  }

  .lang-option.active {
    color: var(--primary);
    font-weight: 700;
    background-color: var(--glass-bg-hover);
  }

  .resume-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--primary);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
    margin-left: 0.25rem;
  }

  .resume-btn:hover {
    background-color: var(--primary-hover);
    transform: translateY(-1px);
  }

  @media (min-width: 768px) {
    .static-brand-container,
    .header-container {
      min-height: 3rem;
    }

    .header-container {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .logo-spacer {
      display: block;
    }

    .logo-group {
      justify-self: start;
    }

    .nav-links {
      display: flex;
      justify-self: center;
    }

    .actions {
      justify-self: end;
    }
  }

  /* Bottom Navigation Styles */
  .bottom-nav {
    position: fixed;
    bottom: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    max-width: 360px;
    margin: 0 auto;
    height: 3.5rem;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur, 16px));
    -webkit-backdrop-filter: blur(var(--glass-blur, 16px));
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow);
    border-radius: var(--radius-full);
    display: flex;
    justify-content: space-around;
    align-items: center;
    z-index: 9999;
    pointer-events: auto;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: all var(--transition-fast);
  }

  .bottom-nav-item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1;
    height: 100%;
    color: var(--text-secondary);
    pointer-events: auto;
    cursor: pointer;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: all var(--transition-fast);
  }

  .bottom-nav-item:hover,
  .bottom-nav-item:focus {
    color: var(--primary);
  }

  .bottom-nav-item span.material-symbols-outlined {
    font-size: 1.5rem;
    transition: transform var(--transition-fast);
  }

  .bottom-nav-item:active span.material-symbols-outlined {
    transform: scale(0.9);
  }

  .bottom-nav-label {
    display: none;
  }

  @media (max-width: 767px) {
    :global(body) {
      padding-bottom: 5rem;
    }

    /* Opciones centrales con Dock ocultas en móviles (solo para pantallas grandes) */
    .nav-links {
      display: none !important;
    }

    /* Logo más compacto en móviles */
    .logo-group {
      padding: 0;
    }

    .logo-text {
      font-size: 1.45rem;
    }

    /* Acciones (Idioma y Tema) en vertical y más reducidas */
    .actions {
      flex-direction: column;
      gap: 0.2rem;
      padding: 0.25rem 0.35rem;
      border-radius: 1.25rem;
    }

    .theme-toggle-btn {
      width: 1.85rem;
      height: 1.85rem;
    }

    .theme-toggle-btn span {
      font-size: 1.05rem;
    }

    .lang-selector-btn {
      width: 1.85rem;
      height: 1.85rem;
      padding: 0;
      font-size: 0.72rem;
    }

    .lang-dropdown {
      top: calc(100% + 0.35rem);
      right: 0;
      min-width: 3.2rem;
      width: max-content;
    }

    .lang-option {
      padding: 0.4rem 0.6rem;
      font-size: 0.75rem;
    }
  }

  @media (min-width: 768px) {
    .bottom-nav {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const initHeaderIntro = () => {
    // 1. Navbar center dock se expande del centro hacia los lados
    const navDock =
      document.querySelector(".header-dock .astro-dock") ||
      document.querySelector(".header-dock");
    if (navDock) {
      gsap.fromTo(
        navDock,
        { scaleX: 0, opacity: 0, transformOrigin: "center center" },
        {
          scaleX: 1,
          opacity: 1,
          duration: 0.75,
          ease: "power3.out",
          delay: 0.15,
        },
      );

      // Los items del dock emergen al expandirse
      const dockItems = document.querySelectorAll(".header-dock .dock-item");
      if (dockItems.length > 0) {
        gsap.fromTo(
          dockItems,
          { scale: 0.5, opacity: 0 },
          {
            scale: 1,
            opacity: 1,
            duration: 0.45,
            stagger: 0.08,
            ease: "back.out(2)",
            delay: 0.35,
          },
        );
      }
    }

    // 2. Las opciones de la derecha brincan ("hacen un brinco")
    const actions = document.querySelector(".actions");
    const actionButtons = document.querySelectorAll(".actions > *");
    if (actions) {
      gsap.fromTo(
        actions,
        { scale: 0.6, opacity: 0 },
        { scale: 1, opacity: 1, duration: 0.4, ease: "power2.out", delay: 0.3 },
      );
      if (actionButtons.length > 0) {
        gsap.fromTo(
          actionButtons,
          { y: -24, scale: 0.55, opacity: 0 },
          {
            y: 0,
            scale: 1,
            opacity: 1,
            duration: 0.65,
            stagger: 0.12,
            ease: "back.out(2.6)",
            delay: 0.38,
          },
        );
      }
    }

    // 3. Logo intro suave
    const logo = document.querySelector(".logo-group");
    if (logo) {
      gsap.fromTo(
        logo,
        { opacity: 0, x: -20 },
        { opacity: 1, x: 0, duration: 0.6, ease: "power2.out", delay: 0.1 },
      );
    }

    // 4. Mobile bottom nav (en pantallas móviles)
    const bottomNav = document.querySelector(".bottom-nav");
    if (bottomNav) {
      gsap.fromTo(
        bottomNav,
        { y: 55, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.65,
          ease: "back.out(1.8)",
          delay: 0.4,
        },
      );
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initHeaderIntro);
  } else {
    initHeaderIntro();
  }
  document.addEventListener("astro:page-load", initHeaderIntro);

  // Theme Toggle
  const toggleBtn = document.getElementById("theme-toggle");
  if (toggleBtn) {
    toggleBtn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
  }

  // Language Dropdown Toggle
  const langBtn = document.getElementById("lang-selector-btn");
  const langContainer = langBtn?.closest(".lang-selector-container");

  if (langBtn && langContainer) {
    langBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      langContainer.classList.toggle("open");
    });

    document.addEventListener("click", () => {
      langContainer.classList.remove("open");
    });
  }

  // Smooth scroll for nav links (mobile bottom nav and desktop dock)
  const navScrollItems = document.querySelectorAll(
    ".bottom-nav-item, .dock-nav-link",
  );
  navScrollItems.forEach((item) => {
    item.addEventListener("click", (e) => {
      const href = item.getAttribute("href");
      if (href && href.includes("#")) {
        const hash = href.split("#")[1];
        const target = document.getElementById(hash);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: "smooth" });
          window.history.pushState(null, "", `#${hash}`);
        }
      } else if (href === "/" || href === "/es") {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  });

  // Smooth scroll to top when clicking logo
  const logoGroup = document.querySelector(".logo-group");
  if (logoGroup) {
    logoGroup.addEventListener("click", (e) => {
      const currentPath = window.location.pathname;
      const href = logoGroup.getAttribute("href");
      if (
        (href === "/" && (currentPath === "/" || currentPath === "")) ||
        (href === "/es" && (currentPath === "/es" || currentPath === "/es/"))
      ) {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    });
  }

  // Preserve scroll position on language change
  const langOptions = document.querySelectorAll(".lang-option");
  langOptions.forEach((option) => {
    option.addEventListener("click", () => {
      sessionStorage.setItem("scrollPosition", window.scrollY.toString());
    });
  });

  // Restore scroll position on load
  const savedScroll = sessionStorage.getItem("scrollPosition");
  if (savedScroll !== null) {
    const scrollY = parseInt(savedScroll, 10);
    window.scrollTo(0, scrollY);

    // Instantly show the body exactly at the restored scroll position
    document.documentElement.classList.remove("js-scroll-restoring");

    // Fallback for dynamic content loading shifts
    window.addEventListener("load", () => {
      window.scrollTo(0, scrollY);
      sessionStorage.removeItem("scrollPosition");
    });

    // Also clear it if the load event already fired
    if (document.readyState === "complete") {
      sessionStorage.removeItem("scrollPosition");
    }
  }
</script>
